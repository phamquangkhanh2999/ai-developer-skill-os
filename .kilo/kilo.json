{
  "project": "ai-developer-skill-os",
  "version": "10.2.0",
  "schema_version": 1,
  "ide": {
    "default": "kilo-code",
    "supported": ["antigravity", "claude", "opencode"]
  },
  "paths": {
    "skills": ".agents/skills",
    "rules": ".agents/rules",
    "workflows": ".agents/workflows",
    "registry": ".agents/registry",
    "docs": ".agents/docs",
    "blueprints": ".agents/blueprints",
    "knowledge": ".agents/knowledge",
    "bin": "bin",
    "tooling": "tooling",
    "tests": "tests"
  },
  "ai_providers": {
    "antigravity": { "provider": "gemini", "config": ".agents/AGENTS.md" },
    "claude": { "provider": "anthropic", "config": ".claude/CLAUDE.md" },
    "opencode": { "provider": "opencode", "config": ".opencode/config.yaml" }
  }
}
