{
  "name": "ai-developer-skill-os",
  "version": "10.2.0",
  "description": "AI Developer Skill OS v10.2 — 11 Governed Core Super-Skills with API Data Discovery Engine, Prompt Compiler Control Plane & Antigravity Cockpit Integration.",
  "main": "bin/install.js",
  "files": [
    "bin",
    ".agents",
    "tooling",
    "package.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "ai-developer-skill-os": "bin/install.js",
    "ai-skill": "bin/install.js"
  },
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "sync:v10": "node tooling/sync-versions.js",
    "build:registry": "node tooling/build-registry.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:registry": "vitest run && node tooling/build-registry.js",
    "test:graph": "node tooling/validate-graph.js",
    "lint": "node tooling/validate-skills.js",
    "install:antigravity": "node bin/install.js --ide=antigravity --scope=2",
    "install:antigravity:local": "node bin/install.js --ide=antigravity --scope=1",
    "install:claude": "node bin/install.js --ide=claude --scope=2",
    "install:claude:local": "node bin/install.js --ide=claude --scope=1",
    "install:opencode": "node bin/install.js --ide=opencode --scope=2",
    "install:opencode:local": "node bin/install.js --ide=opencode --scope=1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phamquangkhanh2999/ai-developer-skill-os.git"
  },
  "keywords": [
    "ai",
    "claude",
    "antigravity",
    "opencode",
    "skill-os",
    "developer",
    "agent",
    "prompts",
    "framework",
    "edaos",
    "manifest",
    "registry",
    "eval"
  ],
  "author": "Quang Khánh",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/phamquangkhanh2999/ai-developer-skill-os/issues"
  },
  "homepage": "https://github.com/phamquangkhanh2999/ai-developer-skill-os#readme",
  "devDependencies": {
    "fast-glob": "^3.3.0",
    "gray-matter": "^4.0.0",
    "js-yaml": "^4.3.2",
    "vitest": "^2.1.0"
  }
}
