# .agentsignore — AI Agent Boundary File
# Files and directories AI agents should NOT load as knowledge context.
# Syntax follows .gitignore conventions.

# Build artifacts
node_modules/
dist/
build/
.cache/
out/
coverage/

# Version control
.git/
.github/

# Packaging / config
*.lock
package-lock.json

# Logs
*.log
logs/

# Binary / generated
*.min.js
*.min.css
*.map
*.wasm
*.png
*.jpg
*.ico
*.woff
*.woff2
*.ttf

# OS artifacts
.DS_Store
Thumbs.db

# IDE internal
.idea/
.vscode/
*.swp
*.swo

# Agent execution scratch
.agents_cache/
.scratch/
.agents/reports/
evals/traces/

# Kilo worktrees
.kilo/

# Generated by install
.ai-skill-os-version
